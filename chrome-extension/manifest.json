{
    "manifest_version": 3,
    "name": "DOM Data Capture",
    "version": "1.0.0",
    "description": "Capture data directly from website DOM elements and send reports via WhatsApp",
    "permissions": [
        "activeTab",
        "storage",
        "alarms",
        "scripting",
        "tabs"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "action": {
        "default_popup": "popup.html"
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["ws-tracker.js"],
            "run_at": "document_start",
            "world": "MAIN"
        }
    ]
}